# Copy to .env and fill in values before running.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Mailgun (https://app.mailgun.com)
MAILGUN_API_KEY=key-...
MAILGUN_DOMAIN=mg.yourdomain.com

# The address users will forward pitch emails to.
# Must match the recipient filter in your Mailgun inbound route.
EVAL_EMAIL=evaluate@mg.yourdomain.com

# Mailgun webhook signing key (Mailgun → Webhooks → HTTP webhook signing key).
# Leave blank to disable signature verification (dev only).
MAILGUN_WEBHOOK_KEY=
